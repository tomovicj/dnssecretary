# --- Keys ---
# Private keys never go into git (good habit, even though these are lab keys).
# Public .key files are ignored too: everyone makes their own with keygen.sh.
keys/

# --- Everything sign.sh produces (can always be regenerated) ---
build/
dsset-*
*.signed
# ...except the hand-made test fixture of DNSSECretary
!dnssecretary/src/test/resources/zones/*.signed
*.zone.in

# DNSSECretary build output (the jar is built on the host, see dnssecretary/README.md)
dnssecretary/target/

# The trust anchor depends on the root key, so it differs for every team member
resolver/root.key
client/delv-anchor.conf

# --- Server runtime files ---
*.pid
*.log
*.db
nsd.db
xfrd.state

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store

# --- Local settings ---
.env
compose.override.yaml

# Web app (webapp/): dependencies and build output (served by dnssecretary serve)
webapp/node_modules/
webapp/dist/
