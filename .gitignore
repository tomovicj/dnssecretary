# --- Ključevi ---
# Privatni ključevi nikad ne idu u git (dobra navika, iako su ovde lab ključevi).
# Javne .key fajlove takođe ignorišemo: svako pravi svoje sa keygen.sh.
keys/

# --- Sve što pravi sign.sh (može uvek ponovo da se napravi) ---
build/
dsset-*
*.signed
*.zone.in

# Trust anchor zavisi od root ključa, pa je različit kod svakog člana tima
resolver/root.key
client/delv-anchor.conf

# --- Runtime fajlovi servera ---
*.pid
*.log
*.db
nsd.db
xfrd.state

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*~
.DS_Store

# --- Lokalna podešavanja ---
.env
compose.override.yaml
