+++ b/webapp/src/styles.css
@@ -0,0 +1,130 @@
+/* Tokens from the design (canvas "DNSSECretary – web app dizajn"). State colours also differ in
+   lightness, and every state carries a word and an icon too, never colour alone. */
+:root {
+  --bg: #f4f5f7;
+  --surface: #ffffff;
+  --surface-muted: #f7f8fa;
+  --border: #dde1e6;
+  --rule: #eef0f3;
+  --input-border: #c4cad3;
+  --ink: #14171c;
+  --ink-2: #3d4552;
+  --ink-3: #4a5260;
+  --accent: #1f5edc;
+  --accent-ink: #163f94;
+  --accent-bg: #eef2fb;
+  --critical: #b42318;
+  --risk: #8a5000;
+  --ok: #22663f;
+  --ok-dot: #2e7d4f;
+  --pass-bg: #e5f3ea;
+  --pass-ink: #1e5c38;
+  --fail-bg: #fce8e6;
+  --fail-ink: #9b1c14;
+  --none-bg: #eef0f3;
+  --fresh: #fff7e0;
+  --code-bg: #14171c;
+  --code-ink: #e6e9ed;
+  --sans: "IBM Plex Sans", system-ui, sans-serif;
+  --mono: "IBM Plex Mono", ui-monospace, monospace;
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; background: var(--bg); color: var(--ink); font: 14px/1.45 var(--sans); }
+a { color: var(--accent); }
+a:hover { color: var(--accent-ink); }
+code, .mono { font-family: var(--mono); font-size: 13px; }
+.muted { color: var(--ink-3); }
+.small { font-size: 13px; }
+.visually-hidden {
+  position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
+}
+
+/* --- shell --- */
+.header { background: var(--surface); border-bottom: 1px solid var(--border); }
+.header-inner, .page { max-width: 1360px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
+.header-inner { padding-top: 14px; padding-bottom: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
+.brand { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 17px; color: var(--ink); text-decoration: none; }
+.nav { display: flex; gap: 4px; }
+.nav a { padding: 8px 12px; border-radius: 6px; color: var(--ink-2); text-decoration: none; }
+.nav a.active { background: var(--accent-bg); color: var(--accent-ink); font-weight: 500; }
+.spacer { flex: 1 1 auto; }
+.live { display: flex; align-items: center; gap: 8px; color: var(--ink-3); }
+.page { padding-top: 28px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 24px; }
+/* flex children may shrink below their content (the table scrolls in its own box, not the page) */
+.page > * { min-width: 0; }
+.page-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; }
+.page-head h1 { margin: 0; font-size: 24px; font-weight: 600; }
+.page-head p { margin: 0; color: var(--ink-3); }
+
+.dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex: none; }
+.dot.small { width: 8px; height: 8px; }
+
+.button {
+  min-height: 40px; padding: 0 14px; border: 1px solid var(--input-border); background: var(--surface);
+  border-radius: 6px; font: inherit; color: var(--ink); cursor: pointer; text-decoration: none;
+  display: inline-flex; align-items: center; gap: 6px;
+}
+.button:hover { border-color: var(--ink-3); color: var(--ink); }
+.button.small { min-height: 36px; padding: 0 12px; font-weight: 500; }
+.button:focus-visible, .chip:focus-visible, a:focus-visible, input:focus-visible {
+  outline: 2px solid var(--accent); outline-offset: 2px;
+}
+
+/* --- summary cards --- */
+.summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
+.card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; }
+.stat { padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
+.stat .value { font-size: 30px; font-weight: 600; }
+.stat .note { color: var(--ink-3); font-size: 13px; }
+@media (max-width: 900px) { .summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+
+/* --- incident list --- */
+.toolbar { padding: 14px 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; border-bottom: 1px solid #e6e9ed; }
+.chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.chip {
+  min-height: 36px; padding: 0 12px; border-radius: 999px; font: inherit; cursor: pointer;
+  background: var(--surface); color: var(--ink); border: 1px solid var(--input-border);
+}
+.chip[aria-pressed="true"] { background: var(--ink); color: #fff; border-color: var(--ink); }
+.search {
+  min-height: 40px; width: 260px; max-width: 100%; padding: 0 12px; border: 1px solid var(--input-border);
+  border-radius: 6px; font: inherit; color: var(--ink);
+}
+/* relative: the visually-hidden labels in the cells are clipped with the table instead of widening the page */
+.table-wrap { overflow-x: auto; position: relative; }
+table.incidents { width: 100%; min-width: 1100px; border-collapse: collapse; }
+.incidents th { white-space: nowrap; text-align: left; color: var(--ink-3); font-size: 13px; font-weight: 500; padding: 10px 16px; border-bottom: 1px solid #e6e9ed; }
+.incidents td { padding: 12px 16px; border-bottom: 1px solid var(--rule); vertical-align: middle; }
+.incidents tr.fresh td { background: var(--fresh); transition: background 0.3s; }
+.incidents td.nowrap { white-space: nowrap; }
+.incidents td.action { padding-top: 8px; padding-bottom: 8px; text-align: right; }
+.state { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; white-space: nowrap; }
+.state.CRITICAL { color: var(--critical); } .state.CRITICAL .dot { background: var(--critical); }
+.state.RISK { color: var(--risk); } .state.RISK .dot { background: var(--risk); }
+.state.OK { color: var(--ok); } .state.OK .dot { background: var(--ok-dot); }
+.problem { display: flex; align-items: baseline; gap: 8px; }
+.problem .issue-id, .problem .muted { flex: none; }
+.issue-id { font-family: var(--mono); font-weight: 500; font-size: 13px; padding: 1px 6px; border-radius: 4px; background: var(--rule); }
+.warn { color: var(--risk); font-weight: 500; }
+.empty { padding: 24px 16px; color: var(--ink-3); }
+.healthy-strip { padding: 14px 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; color: var(--ink-2); }
+
+.badge {
+  display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px 3px 8px; border-radius: 999px;
+  font-size: 13px; font-weight: 500; white-space: nowrap;
+}
+.badge.PASS { background: var(--pass-bg); color: var(--pass-ink); }
+.badge.FAIL { background: var(--fail-bg); color: var(--fail-ink); }
+.badge.RUNNING { background: var(--accent-bg); color: var(--accent-ink); }
+.badge.NONE { background: var(--none-bg); color: var(--ink-2); }
+
+.alert { padding: 12px 16px; border-radius: 8px; background: var(--fail-bg); color: var(--fail-ink); }
+pre.code {
+  margin: 0; padding: 14px 16px; border-radius: 8px; background: var(--code-bg); color: var(--code-ink);
+  font: 13px/1.6 var(--mono); overflow-x: auto;
+}
+
+@media (max-width: 600px) {
+  .header-inner, .page { padding-left: 16px; padding-right: 16px; }
+}
