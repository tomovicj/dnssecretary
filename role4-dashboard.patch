@@ -0,0 +1,87 @@
+// The web API's JSON shapes: the same as dnssecretary/src/main/java/rs/port53/dnssecretary/web/Api.java
+// (the "API contract" of the pivot plan). Instants are ISO-8601 strings; zone names end with a dot.
+
+export type Status = "OK" | "RISK" | "CRITICAL";
+export type Severity = "CRITICAL" | "RISK";
+export type Side = "ZONE" | "PARENT" | "OPERATOR";
+export type VerifiedState = "PASS" | "FAIL" | "RUNNING" | "NONE";
+export type JobKind = "SIMULATION" | "EXECUTION" | "DEMO";
+export type JobState = "QUEUED" | "RUNNING" | "PASS" | "FAIL" | "ERROR";
+
+export interface Issue {
+  id: string; // catalogue ID, e.g. "A1"
+  title: string;
+  severity: Severity;
+  side: Side;
+}
+
+export interface Verified {
+  state: VerifiedState;
+  at: string | null;
+  jobId: string | null;
+}
+
+/** One line of the dashboard. */
+export interface ZoneRow {
+  zone: string;
+  status: Status;
+  issues: Issue[];
+  brokenSince: string | null; // the first scan with this status; null for OK
+  lastScan: string;
+  nextExpiry: string | null; // the earliest RRSIG expiration in the zone
+  verified: Verified;
+}
+
+export interface Script {
+  generated: string; // "" when there is nothing to fix automatically
+  lastSimulated: string | null;
+}
+
+export interface VerifyAnswer {
+  qname: string;
+  qtype: string;
+  rcode: string;
+  ad: boolean;
+  ok: boolean;
+}
+
+export interface VerifyResult {
+  zone: string;
+  checksOk: boolean;
+  remaining: string[];
+  answers: VerifyAnswer[];
+  ok: boolean;
+}
+
+export interface Job {
+  id: string;
+  kind: JobKind;
+  zone?: string;
+  state: JobState;
+  edited: boolean;
+  script: string;
+  startedAt?: string;
+  finishedAt?: string;
+  log?: string[]; // only from GET /api/jobs/{id}
+  verify?: VerifyResult;
+  error?: string;
+}
+
+/** The zone screen: the row, the report as "check --json" prints it, the script and the jobs. */
+export interface ZoneDetail extends ZoneRow {
+  report: unknown; // role 5 types what it shows (diagnoses, findings, …)
+  script: Script;
+  jobs: Job[];
+}
+
+export interface Scenario {
+  zone: string;
+  id: string;
+  title: string;
+}
+
+/** SSE events on /api/events. */
+export type ServerEvent =
+  | { type: "zone"; data: ZoneRow }
+  | { type: "job"; data: Job }
+  | { type: "log"; data: { jobId: string; line: string } };
diff --git a/webapp/src/api/useZones.ts b/webapp/src/api/useZones.ts
new file mode 100644
index 0000000..bab653e
--- /dev/null
+++ b/webapp/src/api/useZones.ts
@@ -0,0 +1,77 @@
+import { useEffect, useRef, useState } from "react";
+import { api, type Backend, type ConnectionStatus } from "./client";
+import type { ZoneRow } from "./types";
+
+export interface LiveZones {
+  rows: ZoneRow[] | null; // null while loading
+  error: string | null;
+  connection: ConnectionStatus;
+  /** Zones whose row changed in the last few seconds (the row lights up). */
+  fresh: Set<string>;
+}
+
+const FRESH_MS = 3000;
+
+/** The zone list, kept live with the "zone" SSE events; reloaded after a lost connection. */
+export function useZones(backend: Backend = api): LiveZones {
+  const [rows, setRows] = useState<ZoneRow[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [connection, setConnection] = useState<ConnectionStatus>("connecting");
+  const [fresh, setFresh] = useState<Set<string>>(new Set());
+  const timers = useRef(new Map<string, ReturnType<typeof setTimeout>>());
+
+  useEffect(() => {
+    let alive = true;
+    let lost = false;
+    const load = () =>
+      backend
+        .zones()
+        .then((r) => {
+          if (!alive) return;
+          setRows(r);
+          setError(null);
+        })
+        .catch((e: Error) => alive && setError(e.message));
+
+    const markFresh = (zone: string) => {
+      setFresh((f) => new Set(f).add(zone));
+      clearTimeout(timers.current.get(zone));
+      timers.current.set(
+        zone,
+        setTimeout(() => {
+          if (!alive) return;
+          setFresh((f) => {
+            const next = new Set(f);
+            next.delete(zone);
+            return next;
+          });
+        }, FRESH_MS),
+      );
+    };
+
+    load();
+    const stop = backend.subscribe(
+      (e) => {
+        if (e.type !== "zone") return;
+        setRows((prev) => (prev ? [...prev.filter((r) => r.zone !== e.data.zone), e.data] : prev));
+        markFresh(e.data.zone);
+      },
+      (s) => {
+        setConnection(s);
+        if (s === "reconnecting") lost = true;
+        if (s === "open" && lost) {
+          lost = false;
+          load(); // events may have been missed
+        }
+      },
+    );
+    const pending = timers.current;
+    return () => {
+      alive = false;
+      stop();
+      pending.forEach(clearTimeout);
+    };
+  }, [backend]);
+
+  return { rows, error, connection, fresh };
+}
